# ===============================
# Gandarilla API - variables de entorno
# Copia los valores a tu configuración de ejecución.
# Spring Boot no carga este archivo automáticamente.
# ===============================

SERVER_PORT=4000

DB_URL=jdbc:postgresql://localhost:5432/Gandarilla
DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
FLYWAY_ENABLED=true

SECURITY_ENABLED=true
API_BEARER_SECRET=CAMBIA_POR_UN_SECRETO_JWT_ALEATORIO_DE_AL_MENOS_32_CARACTERES
API_BEARER_EXPIRATION=1h
WEB_USERNAME=admin
WEB_PASSWORD=CAMBIA_POR_UN_PASSWORD_LARGO_Y_ALEATORIO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20

RECEIPT_CONCEPT=Pago de mantenimiento
RECEIPT_VALIDATED_BY=Tesorería
RECEIPT_ORGANIZATION_NAME=PRIVADA RÍO GANDARILLA A.C.
RECEIPT_ORGANIZATION_AREA=Tesorería
RECEIPT_ARCHIVE_ENABLED=true
RECEIPT_ARCHIVE_PATH=generated-receipts
RECEIPT_MONTHLY_ARCHIVE_PATH=recibos
RECEIPT_DUPLICATE_WINDOW=30s
RECEIPT_FONT_PATH=classpath:fonts/DejaVuSans.ttf

WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=recibo_pago_mantenimiento
WHATSAPP_LANGUAGE_CODE=es_MX
WHATSAPP_CONNECT_TIMEOUT=5s
WHATSAPP_READ_TIMEOUT=20s
